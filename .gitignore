node_modules/
dist/
logs/
_workspace_prev*/

# 실제 접속 정보(카메라 IP·계정·비밀번호)가 들어가는 파일. 절대 커밋하지 않는다.
# 새 머신에서는 config.example.json 을 복사해 채운다.
SettingMain/config/config.json

# 런타임 산출물
SettingMain/config/presets.json

# 커미셔닝 산출 DB(현장 좌표·계정이 들어간다). WAL 동반 파일까지 무시한다.
SettingMain/config/setup.db
SettingMain/config/setup.db-wal
SettingMain/config/setup.db-shm
SettingMain/config/discovery-*.json
SettingMain/config/spots-*.json

# 위 두 파일의 백업본에도 같은 접속 정보(IP·계정·평문 비밀번호)가 그대로 들어간다.
SettingMain/config/*.bak-*

# 원격 개발 PC 접속·기동 절차를 담은 문서와 도구.
#
# 이 저장소는 **공개**다. 아래 것들은 내부망 구조(사설 IP·계정·무인증 포트·무암호 키로
# 여는 SSH 경로)를 한자리에 정리해 두어, 사설망에 발을 들인 사람에게는 지도가 된다.
# 비밀키·비밀번호가 들어 있지는 않지만 공개할 이유도 없다 — 로컬에만 둔다.
#
# 패턴에 실제 주소를 적지 않는다(무시 규칙 자체가 그 정보를 공개해 버린다).
docs/*원격*
docs/20260808_162906_*
scripts/remote-claude.ps1
scripts/.remote-claude-sessions.json

# 런타임 산출물 — 카메라 프로파일 리비전. 장비마다 다르고 도구가 다시 만든다.
profiles/
